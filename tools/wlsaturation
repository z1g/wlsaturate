#!/usr/bin/env python3
"""Wayland saturation CLI for KWin. Drop-in spirit of cmsaturation.pl."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

# wlsaturation_lib.py sits next to this script in the source tree and in
# <prefix>/share/wlsaturation once installed.
_here = Path(__file__).resolve().parent
sys.path[:0] = [str(_here), str(_here.parent / "share" / "wlsaturation")]

from wlsaturation_lib import clamp, enable_effect, kread, kwrite, outputs, reconfigure  # noqa: E402


def print_status() -> int:
    names = outputs()
    global_sat = kread("Saturation", "1.0")
    print(f"global saturation: {global_sat}")
    if not names:
        print("outputs: (none found via kscreen-doctor or KWin supportInformation)")
        return 0
    for name in names:
        per = kread(name)
        shown = per if per else global_sat
        print(f"{name}: {shown}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Set AMD-style saturation on KWin Wayland (0.0–4.0, 1.0 = normal)."
    )
    parser.add_argument("output", nargs="?", help="connector name (kscreen-doctor), or a saturation value for all outputs")
    parser.add_argument("saturation", nargs="?", type=float, help="0.0 grey … 1.0 normal … 4.0 max")
    parser.add_argument("--list", action="store_true", help="list outputs and current values")
    args = parser.parse_args()

    if args.list or args.output is None:
        return print_status()

    target: str | None
    value: float
    try:
        as_float = float(args.output)
    except ValueError:
        as_float = None

    if args.saturation is None:
        if as_float is not None:
            target = None
            value = as_float
        else:
            per = kread(args.output)
            global_sat = kread("Saturation", "1.0")
            print(per if per else global_sat)
            return 0
    else:
        target = args.output
        value = args.saturation

    value = clamp(value)
    enable_effect()
    if target is None:
        kwrite("Saturation", f"{value:.6g}")
        print(f"Saturation of all outputs is {value}")
    else:
        kwrite(target, f"{value:.6g}")
        print(f"Saturation of {target} is {value}")
    reconfigure()
    return 0


if __name__ == "__main__":
    sys.exit(main())
